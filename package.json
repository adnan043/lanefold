{
  "name": "site-app",
  "version": "0.10.21",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "prisma generate && astro dev",
    "build": "prisma generate && astro build",
    "preview": "astro preview",
    "test": "prisma generate && vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "studio": "prisma studio --browser none --port 5555",
    "platform": "node scripts/platform.mjs",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.ts",
    "check": "npm test && npm run build",
    "setup": "node scripts/platform.mjs setup",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "dev-admin": "node scripts/platform.mjs dev-admin"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/react": "^7.0.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/inter": "5.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/adapter-ppg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/driver-adapter-utils": "7.10.1",
    "@prisma/ppg": "1.0.1",
    "@stripe/stripe-js": "10.1.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-virtual": "^3.14.26",
    "astro": "^7.3.8",
    "fractional-indexing": "4.0.0",
    "hono": "^4.13.13",
    "pg-types": "4.0.2",
    "postgres-array": "3.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uqr": "0.1.3",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "7.10.1",
    "typescript": "^7.0.2",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "workerd@1.20261006.1": true,
    "@prisma/engines@7.10.1": true,
    "fsevents": false
  }
}
