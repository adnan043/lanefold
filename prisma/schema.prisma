  messages Message[]

  @@unique([workspaceId, dmKey])
  @@index([workspaceId, kind, id])
  @@index([createdBy])
  @@map("conversations")
}

model ConversationMember {
  conversationId Int       @map("conversation_id")
  userId         Int       @map("user_id")
  workspaceId    Int       @map("workspace_id")
  lastReadSeq    BigInt    @default(0) @map("last_read_seq")
  mutedAt        DateTime? @map("muted_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, workspaceId, conversationId])
  @@map("conversation_members")
}

model Message {
  id             BigInt    @id @default(autoincrement())
  conversationId Int       @map("conversation_id")
  workspaceId    Int       @map("workspace_id")
  seq            BigInt
  senderId       Int?      @map("sender_id")
  bodyMd         String    @map("body_md") @db.VarChar(4000)
  parentId       BigInt?   @map("parent_id")
  /// Client-made key: a retried send returns the same message.
  clientId       String    @map("client_id") @db.VarChar(40)
  /// `user` or `system`.
  kind           String    @default("user") @db.VarChar(8)
  editedAt       DateTime? @map("edited_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  pinnedAt       DateTime? @map("pinned_at") @db.Timestamptz(3)
  replyCount     Int       @default(0) @map("reply_count")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reactions    MessageReaction[]
  mentions     MessageMention[]
  cardRefs     MessageCardRef[]

  @@unique([conversationId, clientId])
  @@unique([conversationId, seq])
  @@index([conversationId, parentId, id])
  @@index([conversationId, parentId, seq])
  @@index([senderId, createdAt])
  @@map("messages")
}

model MessageReaction {
  messageId BigInt   @map("message_id")
  userId    Int      @map("user_id")
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@index([userId])
  @@map("message_reactions")
}

model MessageMention {
  messageId BigInt @map("message_id")
  userId    Int    @map("user_id")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, messageId])
  @@map("message_mentions")
}

model MessageCardRef {
  messageId BigInt @map("message_id")
  cardId    Int    @map("card_id")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, cardId])
  @@index([cardId, messageId])
  @@map("message_card_refs")
}

/// One row, `id = 1`.
model AppSettings {
  id                 Int      @id
  /// `PAID` or `FREE_FOR_ALL` (CHECK in the migration).
  billingMode        String   @default("PAID") @map("billing_mode") @db.VarChar(12)
  graceDays          Int      @default(14) @map("grace_days")
  maintenanceMessage String   @default("") @map("maintenance_message") @db.VarChar(300)
  /// The brand colour the admin chose, `#rrggbb` (CHECK in the migration); null = the default green.
  brandColor         String?  @map("brand_color") @db.VarChar(7)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_settings")
}

model PlanLimit {
  plan              String   @id @db.VarChar(16)
  maxMembers        Int      @map("max_members")
  maxFileBytes      BigInt   @map("max_file_bytes")
  storageQuotaBytes BigInt   @map("storage_quota_bytes")
  maxFlows          Int      @default(0) @map("max_flows")
  /// Price key (payments catalogue) a monthly checkout uses; empty for free.
  priceKeyMonthly   String   @default("") @map("price_key_monthly") @db.VarChar(63)
  auditLog          Boolean  @default(false) @map("audit_log")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("plan_limits")
}

/// Outbox of stored files whose row is gone (set by triggers on attachments, cards.cover_file_id, boards.bg_file_id).
/// The `file-cleanup` job deletes the bytes through the platform, then sets `done_at`.
model FileDeletion {
  id        BigInt    @id @default(autoincrement())
  fileId    String    @unique @map("file_id") @db.VarChar(32)
  attempts  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  doneAt    DateTime? @map("done_at") @db.Timestamptz(3)

  @@index([doneAt, id])
  @@map("file_deletions")
}

/// A custom field a board defines for its cards. `type`: text, number, date, checkbox or dropdown (validator + CHECK).
model CustomField {
  id          Int      @id @default(autoincrement())
  boardId     Int      @map("board_id")
  workspaceId Int      @map("workspace_id")
  name        String   @db.VarChar(40)
  type        String   @db.VarChar(10)
  /// The field's place on the card and in the manager (drag to reorder); ties fall back to id.
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  board   Board              @relation(fields: [boardId], references: [id], onDelete: Cascade)
  options CustomFieldOption[]
  values  CardFieldValue[]

  @@index([workspaceId, boardId, id])
  @@map("custom_fields")
}

model CustomFieldOption {
  id          Int    @id @default(autoincrement())
  fieldId     Int    @map("field_id")
  workspaceId Int    @map("workspace_id")
  name        String @db.VarChar(40)
  colorHex    String @map("color_hex") @db.VarChar(7)

  field  CustomField       @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  values CardFieldValue[]

  @@index([workspaceId, fieldId, id])
  @@map("custom_field_options")
}

/// One typed column per kind (nothing is Json): a row exists only while the card has a value.
model CardFieldValue {
  cardId      Int       @map("card_id")
  fieldId     Int       @map("field_id")
  workspaceId Int       @map("workspace_id")
  textValue   String?   @map("text_value") @db.VarChar(200)
  numberValue Float?    @map("number_value")
  dateValue   DateTime? @map("date_value") @db.Date
  boolValue   Boolean?  @map("bool_value")
  optionId    Int?      @map("option_id")

  card   Card               @relation(fields: [cardId], references: [id], onDelete: Cascade)
  field  CustomField        @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  option CustomFieldOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@id([cardId, fieldId])
  @@index([fieldId, cardId])
  @@index([optionId])
  @@map("card_field_values")
}

/// "blocker blocks blocked", both cards on the same board. No cycles (checked in the route, under the board lock).
model CardDependency {
  blockerId   Int      @map("blocker_id")
  blockedId   Int      @map("blocked_id")
  workspaceId Int      @map("workspace_id")
  boardId     Int      @map("board_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  blocker Card @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Card @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@index([workspaceId, boardId])
  @@map("card_dependencies")
}

/// One automation rule of a board (Phase 7): trigger, optional conditions, up to 3 actions.
/// `config` is validated field by field on every write (src/lib/flows.ts) and again before it runs; nothing is filtered on it.
model Flow {
  id          Int       @id @default(autoincrement())
  boardId     Int       @map("board_id")
  workspaceId Int       @map("workspace_id")
  name        String    @db.VarChar(80)
  /// `card_created`, `card_moved` or `daily_due`.
  triggerKind String    @map("trigger_kind") @db.VarChar(16)
  enabled     Boolean   @default(true)
  config      Json      @db.JsonB
  /// Scheduled flows only: the UTC day the daily job last ran this flow (its claim, so a retry never runs it twice).
  lastRunOn   DateTime? @map("last_run_on") @db.Date
  createdBy   Int?      @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, triggerKind, enabled])
  @@index([workspaceId, id])
  @@index([triggerKind, enabled, id])
  @@map("flows")
}

/// A repeat rule on a card: a scheduled job makes a fresh copy on each due day (`next_run_on`), then moves it on.
/// `frequency`: daily, weekly or monthly (CHECK). One rule per card; the copies carry no rule.
model CardRecurrence {
  cardId      Int       @id @map("card_id")
  workspaceId Int       @map("workspace_id")
  boardId     Int       @map("board_id")
  frequency   String    @db.VarChar(8)
  /// Every `intervalCount` days, weeks or months (1 to 99, CHECK); `endsOn` is the last day a copy may be made.
  intervalCount Int     @default(1) @map("interval_count")
  endsOn      DateTime? @map("ends_on") @db.Date
  anchorOn    DateTime  @map("anchor_on") @db.Date
  nextRunOn   DateTime  @map("next_run_on") @db.Date
  lastRunOn   DateTime? @map("last_run_on") @db.Date
  enabled     Boolean   @default(true)
  createdBy   Int?      @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([enabled, nextRunOn, cardId])
  @@index([workspaceId])
  @@map("card_recurrences")
}

/// A saved template a workspace shares. `kind` `card`: title, description, priority, estimate, checklists, label names.
/// `kind` `board`: lane names. The payload is validated on the way in and read back through the same shape.
model CardTemplate {
  id          Int      @id @default(autoincrement())
  workspaceId Int      @map("workspace_id")
  kind        String   @db.VarChar(8)
  name        String   @db.VarChar(80)
  payload     Json
  createdBy   Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, kind, id])
  @@map("card_templates")
}

/// Time logged on a card: whole minutes (1 to 1440) spent on a day. `userId` goes null when the person's account is deleted.
model TimeEntry {
  id          Int      @id @default(autoincrement())
  cardId      Int      @map("card_id")
  boardId     Int      @map("board_id")
  workspaceId Int      @map("workspace_id")
  userId      Int?     @map("user_id")
  minutes     Int
  spentOn     DateTime @map("spent_on") @db.Date
  note        String   @default("") @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, spentOn(sort: Desc), id(sort: Desc)])
  @@index([boardId, spentOn])
  @@index([workspaceId, userId, spentOn])
  @@index([userId])
  @@map("time_entries")
}

/// The running timer of one person (at most one: `userId` is the key). Stopping turns it into a `time_entries` row.
model TimeTimer {
  userId      Int      @id @map("user_id")
  cardId      Int      @map("card_id")
  boardId     Int      @map("board_id")
  workspaceId Int      @map("workspace_id")
  startedAt   DateTime @default(now()) @map("started_at") @db.Timestamptz(3)

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@map("time_timers")
}
