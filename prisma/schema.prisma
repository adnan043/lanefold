// The Site Database's schema (Prisma ORM 7). Change it, then run
// `npx prisma migrate dev --create-only --name <what-changed>` against the
// Preview Database, wrap the new migration.sql in BEGIN; … COMMIT;, apply it
// with `npx prisma migrate dev`, then `npx prisma generate` (docs/agent/database.md).
//
// Tables marked MANAGED belong to the template's auth core (src/platform/auth):
// add columns to them only through a template upgrade.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // The client runs in the Cloudflare Workers runtime, never in Node.
  runtime         = "workerd"
  // ONE SQL query per read: a nested `select` of related rows is joined in the database instead
  // of one extra query per relation (each query is an HTTPS round trip). docs/agent/database.md.
  previewFeatures = ["relationJoins"]
}

// TESTS ONLY: the same client for Node, so `npm test` can run the real Site API
// against a real Postgres (vitest aliases the import to it). Never imported by
// site code; git-ignored like the one above.
generator nodeClient {
  provider        = "prisma-client"
  output          = "../src/generated/prisma-node"
  runtime         = "nodejs"
  previewFeatures = ["relationJoins"]
}

// The connection string is NOT here: prisma.config.ts reads DATABASE_URL from
// the environment, which the platform sets (the Build never gets one).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- auth (MANAGED)

/// A person with an account on this site. `email` is stored trimmed and
/// lower-cased. Only the user and holders of `site:user:read` ever see it.
model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique @db.VarChar(254)
  /// `pbkdf2-sha256$v1$<iterations>$<salt>$<key>` (src/platform/auth/password.ts).
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  name              String    @db.VarChar(80)
  /// `active` or `suspended`.
  status            String    @default("active") @db.VarChar(16)
  emailVerifiedAt   DateTime? @map("email_verified_at")
  /// Bumped on password change, logout-all and suspension: every access token
  /// carrying an older value stops working at once.
  sessionVersion    Int       @default(1) @map("session_version")
  lastLoginAt       DateTime? @map("last_login_at")
  /// Two-step sign-in (src/platform/auth/two-factor.ts): the authenticator secret, SEALED
  /// (never in clear), set once the user confirmed a first code (`totpEnabledAt`).
  totpSecretSealed  String?   @map("totp_secret_sealed") @db.VarChar(255)
  /// A secret shown during setup, not yet confirmed with a code.
  totpPendingSealed String?   @map("totp_pending_sealed") @db.VarChar(255)
  totpEnabledAt     DateTime? @map("totp_enabled_at")
  /// The 30-second step of the last accepted code: that code (and older) never works again.
  totpLastStep      Int?      @map("totp_last_step")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  roles              UserRole[]
  refreshTokens      RefreshToken[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
  emailChanges       EmailChange[]
  recoveryCodes      RecoveryCode[]
  signInCodes        SignInCode[]

  @@index([status, id])
  @@map("users")
}

/// A role: a named set of permissions. `is_system` roles (owner, admin,
/// member) are seeded and cannot be deleted; `owner` cannot be edited.
model Role {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(48)
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// The permission catalogue: one row per codename (`site:job:manage`,
/// `site:user:*`, `*`). Shipped as idempotent migrations, matched by codename.
model Permission {
  id          Int      @id @default(autoincrement())
  codename    String   @unique @db.VarChar(128)
  title       String   @db.VarChar(120)
  description String?  @db.VarChar(255)
  /// Groups the catalogue in the roles screen ("Users", "Jobs").
  groupName   String   @default("General") @map("group_name") @db.VarChar(48)
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  grantedBy    Int?     @map("granted_by")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    Int      @map("user_id")
  roleId    Int      @map("role_id")
  grantedBy Int?     @map("granted_by")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId, userId])
  @@map("user_roles")
}

/// One refresh token, stored only as its SHA-256. Tokens of one sign-in share
/// a `family_id`; each rotation marks the old row used and points the new
/// row at it (`rotated_from`). Reuse of a used token revokes the family.
model RefreshToken {
  id                BigInt    @id @default(autoincrement())
  familyId          String    @map("family_id") @db.Uuid
  userId            Int       @map("user_id")
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  rotatedFromId     BigInt?   @map("rotated_from")
  usedAt            DateTime? @map("used_at")
  revokedAt         DateTime? @map("revoked_at")
  revokedReason     String?   @map("revoked_reason") @db.VarChar(16)
  expiresAt         DateTime  @map("expires_at")
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  userAgent         String?   @map("user_agent") @db.VarChar(255)
  ipHash            String?   @map("ip_hash") @db.Char(64)
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// A single-use password reset link (30 minutes), stored as its SHA-256.
model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ipHash    String?   @map("ip_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_resets")
}

/// A single-use email confirmation link (24 hours), stored as its SHA-256.
model EmailVerification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  /// The address this link confirms (the user's email when it was sent).
  email     String    @db.VarChar(254)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("email_verifications")
}

/// A 6-digit sign-in code emailed to the account (src/platform/auth/code-routes.ts): 10 minutes,
/// single use, 5 wrong tries and it is spent. Only its keyed hash is stored. A new code ends the
/// older ones.
model SignInCode {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  codeHash  String    @map("code_hash") @db.Char(64)
  tries     Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ipHash    String?   @map("ip_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("sign_in_codes")
}

/// Rate-limit ledger: one row per attempt. Keyed hashes only (never the raw
/// email or IP). Rows older than a day are swept on the way.
model LoginAttempt {
  id        BigInt   @id @default(autoincrement())
  /// `login`, `register`, `reset`, `verify`, `password`, `code`, `codecheck`, ….
  kind      String   @db.VarChar(16)
  emailHash String?  @map("email_hash") @db.Char(64)
  ipHash    String   @map("ip_hash") @db.Char(64)
  succeeded Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([kind, emailHash, createdAt])
  @@index([kind, ipHash, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}

/// Security-relevant events (sign-ups, password changes, role changes,
/// refresh-token reuse). No email addresses, no raw IPs, no secrets.
/// A pending move of an account to a new address: the link mailed to the NEW address
/// (`/account/confirm-email/?token=…`) finishes it; single use, 24 hours.
model EmailChange {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  newEmail  String    @map("new_email") @db.VarChar(254)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("email_changes")
}

/// Two-step sign-in recovery codes, as SHA-256 hashes; each works once.
model RecoveryCode {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("recovery_codes")
}

model AuditEvent {
  id          BigInt   @id @default(autoincrement())
  actorUserId Int?     @map("actor_user_id")
  action      String   @db.VarChar(64)
  targetType  String?  @map("target_type") @db.VarChar(32)
  targetId    String?  @map("target_id") @db.VarChar(64)
  ipHash      String?  @map("ip_hash") @db.Char(64)
  /// Small, non-personal details (`{"roles":["admin"]}`). Never filtered on.
  meta        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorUserId, id])
  @@index([targetType, targetId, id])
  @@map("audit_events")
}

/// One row (`id = 1`): who claimed the owner role first. Claimed with a
/// conditional update, so two simultaneous sign-ups can never both become owner.
model AuthState {
  id          Int      @id
  ownerUserId Int?     @map("owner_user_id")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("auth_state")
}

/// Background job deliveries already taken (`src/platform/background.ts`): the
/// replay guard for signed deliveries, across every Worker instance. One row
/// per job try; rows older than a day are swept on the way.
model JobDelivery {
  jobId   String   @map("job_id")
  attempt Int
  seenAt  DateTime @default(now()) @map("seen_at")

  @@id([jobId, attempt])
  @@index([seenAt])
  @@map("job_deliveries")
}

// ---------------------------------------------------------------- payments (MANAGED)
// Filled by src/server/payments-hooks.ts from the platform's payment events (and the thanks
// page's confirm). Add columns only through a template upgrade; keep your own data in your own
// tables, pointing at `checkout_id` / `subscription_id`.

/// Payment events already handled, by event id (`src/platform/payments.ts`): a retried or
/// replayed event runs its hook once. Rows older than 90 days are swept on the way.
model PaymentEvent {
  id         String   @id @db.VarChar(128)
  type       String   @db.VarChar(40)
  receivedAt DateTime @default(now()) @map("received_at")

  @@index([receivedAt])
  @@map("payment_events")
}

/// One paid (or failed / refunded) checkout. `checkout_id` is the platform's `pcs_…`.
model Order {
  id          Int       @id @default(autoincrement())
  checkoutId  String    @unique @map("checkout_id") @db.VarChar(80)
  priceKey    String    @map("price_key") @db.VarChar(63)
  /// `test` (sandbox) or `live`.
  mode        String    @default("test") @db.VarChar(4)
  email       String?   @db.VarChar(254)
  /// The signed-in buyer (`users.id`), from the checkout's `customerRef`. No foreign key: an
  /// order outlives a deleted account.
  userId      Int?      @map("user_id")
  /// `paid`, `failed`, `refunded` or `partially_refunded`.
  status      String    @db.VarChar(20)
  quantity    Int       @default(1)
  amountCents Int       @map("amount_cents")
  currency    String    @db.Char(3)
  metadata    Json?
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userId, id])
  @@index([email, id])
  @@map("orders")
}

/// A subscription bought on this site. Access: `active`, `trialing`, `past_due`, or `canceled`
/// until `access_ends_at` (`grantsAccess` in src/platform/payments.ts).
model Membership {
  id               Int       @id @default(autoincrement())
  subscriptionId   String    @unique @map("subscription_id") @db.VarChar(128)
  priceKey         String    @map("price_key") @db.VarChar(63)
  mode             String    @default("test") @db.VarChar(4)
  email            String?   @db.VarChar(254)
  userId           Int?      @map("user_id")
  status           String    @db.VarChar(20)
  currentPeriodEnd DateTime? @map("current_period_end")
  accessEndsAt     DateTime? @map("access_ends_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([userId, priceKey])
  @@index([email, priceKey])
  @@map("memberships")
}

// ---------------------------------------------------------------- the site's own data

/// A job on the job board (`/jobs`, `/jobs/<slug>`). Holders of
/// `site:job:manage` post and edit them from `/portal/jobs`.
model Job {
  id          Int      @id @default(autoincrement())
  /// URL name, unique: `/jobs/<slug>`.
  slug        String   @unique @db.VarChar(120)
  title       String   @db.VarChar(120)
  company     String   @db.VarChar(80)
  location    String   @db.VarChar(80)
  /// `full-time`, `part-time`, `contract` or `internship`.
  type        String   @default("full-time") @db.VarChar(20)
  remote      Boolean  @default(false)
  /// Plain text; paragraphs separated by blank lines.
  description String   @db.VarChar(10000)
  /// Where to apply: an https URL or a mailto: link the poster chose to publish.
  applyUrl    String   @map("apply_url") @db.VarChar(500)
  /// `open` (listed) or `closed` (kept, not listed).
  status      String   @default("open") @db.VarChar(10)
  /// The user (`users.id`) who posted it. No foreign key: a job outlives its poster.
  createdBy   Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status, id])
  @@map("jobs")
}

// ---------------------------------------------------------------- Lanefold (docs/product/SPEC.md §6)
// No foreign keys to `users` (managed table): a user id is a plain Int, and a daily cleanup job removes rows
// of deleted accounts. Every workspace-owned table carries `workspace_id` FIRST in its indexes.
// `position` columns are COLLATE "C" (migration SQL) so fractional-index keys sort by bytes.

/// Per-user preferences (theme, language). One row per user, created on first use.
model UserProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique @map("user_id")
  locale         String   @default("en") @db.VarChar(8)
  timezone       String   @default("UTC") @db.VarChar(64)
  firstDayOfWeek Int      @default(1) @map("first_day_of_week")
  /// `light`, `dark`, `system` or `contrast`.
  themeMode      String   @default("system") @map("theme_mode") @db.VarChar(10)
  accentHex      String   @default("#5B5BD6") @map("accent_hex") @db.VarChar(7)
  /// `compact`, `comfortable` or `spacious`.
  density        String   @default("comfortable") @db.VarChar(12)
  /// Percent, 90 to 130.
  fontScale      Int      @default(100) @map("font_scale")
  /// `sharp`, `soft` or `round`.
  radius         String   @default("soft") @db.VarChar(8)
  reduceMotion   Boolean  @default(false) @map("reduce_motion")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("user_profiles")
}

model Workspace {
  id               Int       @id @default(autoincrement())
  name             String    @db.VarChar(80)
  slug             String    @unique @db.VarChar(60)
  /// `free`, `pro` or `team` (plan_limits.plan).
  plan             String    @default("free") @db.VarChar(16)
  memberLimit      Int       @default(10) @map("member_limit")
  memberCount      Int       @default(0) @map("member_count")
  storageUsedBytes BigInt    @default(0) @map("storage_used_bytes")
  brandAccentHex   String?   @map("brand_accent_hex") @db.VarChar(7)
  enforceTheme     Boolean   @default(false) @map("enforce_theme")
  defaultLocale    String    @default("en") @map("default_locale") @db.VarChar(8)
  graceUntil       DateTime? @map("grace_until") @db.Timestamptz(3)
  createdBy        Int       @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  members   WorkspaceMember[]
  invites   WorkspaceInvite[]
  joinLinks WorkspaceJoinLink[]
  boards    Board[]

  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId Int      @map("workspace_id")
  userId      Int      @map("user_id")
  /// `owner`, `admin`, `member` or `viewer`.
  role        String   @db.VarChar(10)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId, workspaceId])
  @@map("workspace_members")
}

/// Single-use link bound to an email (the email is only a hash; never copied).
model WorkspaceInvite {
  id          Int       @id @default(autoincrement())
  workspaceId Int       @map("workspace_id")
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  /// SHA-256 of the lower-cased email the link is bound to; null = anyone who signs in.
  emailHash   String?   @map("email_hash") @db.VarChar(64)
  role        String    @db.VarChar(10)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  createdBy   Int       @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, id])
  @@map("workspace_invites")
}

model WorkspaceJoinLink {
  id          Int       @id @default(autoincrement())
  workspaceId Int       @map("workspace_id")
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  role        String    @db.VarChar(10)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  maxUses     Int       @map("max_uses")
  uses        Int       @default(0)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdBy   Int       @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, id])
  @@map("workspace_join_links")
}

model Board {
  id             Int       @id @default(autoincrement())
  workspaceId    Int       @map("workspace_id")
  name           String    @db.VarChar(80)
  /// `private` (board members), `workspace` or `public` (read-only link).
  visibility     String    @default("workspace") @db.VarChar(10)
  /// `color`, `gradient`, `pattern` or `image`.
  bgKind         String    @default("color") @map("bg_kind") @db.VarChar(10)
  bgColor1       String    @default("#F4F4F5") @map("bg_color_1") @db.VarChar(7)
  bgColor2       String    @default("#E7E5E4") @map("bg_color_2") @db.VarChar(7)
  bgAngle        Int       @default(135) @map("bg_angle")
  bgPattern      String    @default("none") @map("bg_pattern") @db.VarChar(16)
  bgFileId       String?   @map("bg_file_id") @db.VarChar(32)
  shareTokenHash String?   @unique @map("share_token_hash") @db.VarChar(64)
  /// Bumped by every write transaction; clients poll it (SPEC §8).
  rev            BigInt    @default(0)
  /// Personal Inbox board of one user (`inbox_of`), else null.
  inboxOf        Int?      @map("inbox_of")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdBy      Int       @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lanes        Lane[]
  cards        Card[]
  labels       Label[]
  boardMembers BoardMember[]
  boardStars   BoardStar[]

  @@index([workspaceId, archivedAt, id])
  @@index([inboxOf, workspaceId])
  @@map("boards")
}

model BoardMember {
  boardId     Int      @map("board_id")
  userId      Int      @map("user_id")
  workspaceId Int      @map("workspace_id")
  /// `admin`, `member` or `viewer`: overrides the workspace role on this board.
  role        String   @db.VarChar(10)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
  @@index([userId, workspaceId])
  @@map("board_members")
}

model BoardStar {
  userId    Int      @map("user_id")
  boardId   Int      @map("board_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@id([userId, boardId])
  @@index([boardId])
  @@map("board_stars")
}

model Lane {
  id          Int       @id @default(autoincrement())
  boardId     Int       @map("board_id")
  workspaceId Int       @map("workspace_id")
  name        String    @db.VarChar(80)
  /// Fractional-index key; COLLATE "C" (migration SQL).
  position    String    @db.VarChar(64)
  colorHex    String?   @map("color_hex") @db.VarChar(7)
  wipLimit    Int?      @map("wip_limit")
  cardCount   Int       @default(0) @map("card_count")
  collapsed   Boolean   @default(false)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  updatedRev  BigInt    @default(0) @map("updated_rev")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([workspaceId, boardId, position, id])
  @@index([boardId, updatedRev])
  @@map("lanes")
}

model Card {
  id              Int       @id @default(autoincrement())
  boardId         Int       @map("board_id")
  laneId          Int       @map("lane_id")
  workspaceId     Int       @map("workspace_id")
  title           String    @db.VarChar(200)
  descriptionMd   String    @default("") @map("description_md") @db.VarChar(20000)
  position        String    @db.VarChar(64)
  /// `none`, `low`, `medium`, `high` or `urgent`.
  priority        String    @default("none") @db.VarChar(8)
  estimateMinutes Int?      @map("estimate_minutes")
  startDate       DateTime? @map("start_date") @db.Date
  dueDate         DateTime? @map("due_date") @db.Date
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(3)
  coverFileId     String?   @map("cover_file_id") @db.VarChar(32)
  checklistTotal  Int       @default(0) @map("checklist_total")
  checklistDone   Int       @default(0) @map("checklist_done")
  commentCount    Int       @default(0) @map("comment_count")
  attachmentCount Int       @default(0) @map("attachment_count")
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)
  updatedRev      BigInt    @default(0) @map("updated_rev")
  /// Import key: a re-run of an import skips cards it already made.
  importId        String?   @map("import_id") @db.VarChar(40)
  externalId      String?   @map("external_id") @db.VarChar(64)
  createdBy       Int       @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  board       Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  lane        Lane          @relation(fields: [laneId], references: [id], onDelete: Cascade)
  members     CardMember[]
  watchers    CardWatcher[]
  labels      CardLabel[]
  checklists  Checklist[]
  comments    Comment[]
  attachments Attachment[]

  @@unique([boardId, importId, externalId])
  @@index([workspaceId, laneId, position, id])
  @@index([boardId, updatedRev])
  @@index([workspaceId, dueDate, id])
  @@map("cards")
}

model CardMember {
  cardId      Int      @map("card_id")
  userId      Int      @map("user_id")
  workspaceId Int      @map("workspace_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
  @@index([userId, workspaceId, cardId])
  @@map("card_members")
}

model CardWatcher {
  cardId    Int      @map("card_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
  @@index([userId, cardId])
  @@map("card_watchers")
}

model Label {
  id          Int      @id @default(autoincrement())
  boardId     Int      @map("board_id")
  workspaceId Int      @map("workspace_id")
  name        String   @db.VarChar(40)
  colorHex    String   @map("color_hex") @db.VarChar(7)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  board Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards CardLabel[]

  @@index([workspaceId, boardId, id])
  @@map("labels")
}

model CardLabel {
  cardId  Int @map("card_id")
  labelId Int @map("label_id")

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId, cardId])
  @@map("card_labels")
}

model Checklist {
  id          Int      @id @default(autoincrement())
  cardId      Int      @map("card_id")
  workspaceId Int      @map("workspace_id")
  title       String   @db.VarChar(100)
  position    String   @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  card  Card            @relation(fields: [cardId], references: [id], onDelete: Cascade)
  items ChecklistItem[]

  @@index([workspaceId, cardId, position, id])
  @@map("checklists")
}

model ChecklistItem {
  id          Int       @id @default(autoincrement())
  checklistId Int       @map("checklist_id")
  workspaceId Int       @map("workspace_id")
  text        String    @db.VarChar(300)
  position    String    @db.VarChar(64)
  doneAt      DateTime? @map("done_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([workspaceId, checklistId, position, id])
  @@map("checklist_items")
}

model Comment {
  id          Int       @id @default(autoincrement())
  cardId      Int       @map("card_id")
  workspaceId Int       @map("workspace_id")
  /// No foreign key: shows as "Deleted user" when the account is gone.
  authorId    Int       @map("author_id")
  bodyMd      String    @map("body_md") @db.VarChar(5000)
  editedAt    DateTime? @map("edited_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  card     Card             @relation(fields: [cardId], references: [id], onDelete: Cascade)
  mentions CommentMention[]

  @@index([workspaceId, cardId, id])
  @@index([authorId, createdAt])
  @@map("comments")
}

model CommentMention {
  commentId Int @map("comment_id")
  userId    Int @map("user_id")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId, commentId])
  @@map("comment_mentions")
}

/// A file on a card or in a chat message. The bytes live in the platform's file storage (`fileId`).
model Attachment {
  id          Int      @id @default(autoincrement())
  workspaceId Int      @map("workspace_id")
  cardId      Int?     @map("card_id")
  messageId   BigInt?  @map("message_id")
  /// Platform file id for uploads; null for a plain link attachment (`url`).
  fileId      String?  @unique @map("file_id") @db.VarChar(32)
  url         String?  @db.VarChar(500)
  name        String   @db.VarChar(200)
  contentType String   @default("") @map("content_type") @db.VarChar(127)
  size        Int      @default(0)
  ready       Boolean  @default(false)
  uploadedBy  Int      @map("uploaded_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  card Card? @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([workspaceId, cardId, id])
  @@index([workspaceId, messageId, id])
  @@index([uploadedBy, createdAt])
  @@map("attachments")
}

model CardLink {
  id           Int      @id @default(autoincrement())
  workspaceId  Int      @map("workspace_id")
  cardId       Int      @map("card_id")
  linkedCardId Int      @map("linked_card_id")
  /// `relates`, `blocks` or `duplicates`.
  kind         String   @default("relates") @db.VarChar(10)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([cardId, linkedCardId, kind])
  @@index([workspaceId, linkedCardId])
  @@map("card_links")
}

/// Append-only board history.
model Activity {
  id          BigInt   @id @default(autoincrement())
  workspaceId Int      @map("workspace_id")
  boardId     Int?     @map("board_id")
  cardId      Int?     @map("card_id")
  actorId     Int      @map("actor_id")
  /// Stable code like `card.created`, `card.moved`; the UI localizes it.
  kind        String   @db.VarChar(40)
  meta        Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([workspaceId, boardId, id(sort: Desc)])
  @@index([workspaceId, cardId, id(sort: Desc)])
  @@map("activity")
}

model Notification {
  id             BigInt    @id @default(autoincrement())
  userId         Int       @map("user_id")
  workspaceId    Int       @map("workspace_id")
  /// `assigned`, `mentioned`, `due_soon`, `comment`, `message_mention`.
  kind           String    @db.VarChar(20)
  actorId        Int?      @map("actor_id")
  boardId        Int?      @map("board_id")
  cardId         Int?      @map("card_id")
  conversationId Int?      @map("conversation_id")
  readAt         DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, id(sort: Desc)])
  @@index([userId, readAt, id])
  @@map("notifications")
}

model SavedFilter {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  workspaceId Int      @map("workspace_id")
  boardId     Int      @map("board_id")
  name        String   @db.VarChar(60)
  /// Opaque snapshot of the filter bar.
  filter      Json     @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, boardId, id])
  @@index([boardId, id])
  @@map("saved_filters")
}

model Conversation {
  id          Int      @id @default(autoincrement())
  workspaceId Int      @map("workspace_id")
  boardId     Int?     @unique @map("board_id")
  /// `dm`, `group`, `channel` or `board`.
  kind        String   @db.VarChar(8)
  name        String?  @db.VarChar(80)
  /// `<smaller user id>:<larger user id>` for a DM, so a pair has one conversation.
  dmKey       String?  @map("dm_key") @db.VarChar(24)
  lastSeq     BigInt   @default(0) @map("last_seq")
  createdBy   Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  members  ConversationMember[]
  messages Message[]

  @@unique([workspaceId, dmKey])
  @@index([workspaceId, kind, id])
  @@map("conversations")
}

model ConversationMember {
  conversationId Int       @map("conversation_id")
  userId         Int       @map("user_id")
  workspaceId    Int       @map("workspace_id")
  lastReadSeq    BigInt    @default(0) @map("last_read_seq")
  mutedAt        DateTime? @map("muted_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, workspaceId, conversationId])
  @@map("conversation_members")
}

model Message {
  id             BigInt    @id @default(autoincrement())
  conversationId Int       @map("conversation_id")
  workspaceId    Int       @map("workspace_id")
  seq            BigInt
  senderId       Int       @map("sender_id")
  bodyMd         String    @map("body_md") @db.VarChar(4000)
  parentId       BigInt?   @map("parent_id")
  /// Client-made key: a retried send returns the same message.
  clientId       String    @map("client_id") @db.VarChar(40)
  /// `user` or `system`.
  kind           String    @default("user") @db.VarChar(8)
  editedAt       DateTime? @map("edited_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  pinnedAt       DateTime? @map("pinned_at") @db.Timestamptz(3)
  replyCount     Int       @default(0) @map("reply_count")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reactions    MessageReaction[]
  mentions     MessageMention[]
  cardRefs     MessageCardRef[]

  @@unique([conversationId, clientId])
  @@unique([conversationId, seq])
  @@index([conversationId, parentId, id])
  @@index([senderId, createdAt])
  @@map("messages")
}

model MessageReaction {
  messageId BigInt   @map("message_id")
  userId    Int      @map("user_id")
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@map("message_reactions")
}

model MessageMention {
  messageId BigInt @map("message_id")
  userId    Int    @map("user_id")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, messageId])
  @@map("message_mentions")
}

model MessageCardRef {
  messageId BigInt @map("message_id")
  cardId    Int    @map("card_id")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, cardId])
  @@index([cardId, messageId])
  @@map("message_card_refs")
}

/// One row, `id = 1`.
model AppSettings {
  id                 Int      @id
  /// `PAID` or `FREE_FOR_ALL` (CHECK in the migration).
  billingMode        String   @default("PAID") @map("billing_mode") @db.VarChar(12)
  graceDays          Int      @default(14) @map("grace_days")
  maintenanceMessage String   @default("") @map("maintenance_message") @db.VarChar(300)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_settings")
}

model PlanLimit {
  plan              String   @id @db.VarChar(16)
  maxMembers        Int      @map("max_members")
  maxFileBytes      BigInt   @map("max_file_bytes")
  storageQuotaBytes BigInt   @map("storage_quota_bytes")
  maxFlows          Int      @default(0) @map("max_flows")
  /// Price key (payments catalogue) a monthly checkout uses; empty for free.
  priceKeyMonthly   String   @default("") @map("price_key_monthly") @db.VarChar(63)
  auditLog          Boolean  @default(false) @map("audit_log")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("plan_limits")
}
