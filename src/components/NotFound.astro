---
/**
 * The branded 404 body — rendered by `pages/404.astro` for any address with no
 * page, and by the post page for an unknown slug. Both set a 404 status.
 */
import type {Site} from '../lib/types';
import BrandMark from './BrandMark.astro';

interface Props {
  site: Site | null;
}

const {site} = Astro.props;
---

<main id="main" tabindex="-1" class="wrap narrow section center">
  <BrandMark site={site} size={56} />
  <p class="eyebrow">404</p>
  <h1>We can’t find that page</h1>
  <p class="lede">The link may be old or mistyped. Nothing is lost: head back home or pick up where you left off in {site?.name ?? 'this site'}.</p>
  <p class="actions">
    <a class="button" href="/" data-astro-prefetch>Home</a>
    <a class="button ghost" href="/app/">Open your boards</a>
  </p>
</main>
