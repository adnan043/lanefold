---
/**
 * The home hero's picture: an app window (title bar, sidebar, a board with
 * three lanes and the board's chat beside it), drawn in HTML and CSS
 * (home.css, `.hv-*`) so it follows the theme. Decorative: the whole thing is
 * `aria-hidden`; its words come from `HOME.visual` in `src/content/site.ts`.
 * No images, no scripts; the only motion is a hover lift, off with reduced motion.
 */
import {HOME} from '../../content/site';

const v = HOME.visual;
const {name = 'Lanefold'} = Astro.props as {name?: string};
---

<div class="hv" aria-hidden="true">
  <div class="hv-bar">
    <span class="hv-lights"><i></i><i></i><i></i></span>
    <span class="hv-url">{name} / {v.title}</span>
  </div>
  <div class="hv-body">
    <div class="hv-side">
      <span class="hv-ws"><b>{name.slice(0, 1).toUpperCase()}</b>{name}</span>
      {v.nav.map((item, i) => <span class:list={['hv-nav', {'hv-nav-on': i === 0}]}><i></i>{item}</span>)}
      <span class="hv-side-label">Boards</span>
      <span class="hv-nav hv-nav-board hv-nav-on-soft"><i></i>{v.title}</span>
      <span class="hv-nav hv-nav-board"><i></i>Roadmap</span>
    </div>
    <div class="hv-main">
      <div class="hv-head">
        <span class="hv-title">{v.title}</span>
        <span class="hv-avatars"><i></i><i></i><i></i></span>
      </div>
      <div class="hv-lanes">
        {
          v.lanes.map(lane => (
            <div class:list={['hv-lane', `hv-lane-${lane.tone}`]}>
              <div class="hv-lane-head">
                <span class="hv-dot"></span>
                <span class="hv-lane-name">{lane.name}</span>
                <span class="hv-count">{lane.cards.length}</span>
              </div>
              {lane.cards.map(card => (
                <div class="hv-card">
                  <span class="hv-label"></span>
                  <span class="hv-card-title">{card.title}</span>
                  <span class="hv-card-meta">
                    {card.flag && <span class="hv-flag"><svg viewBox="0 0 12 12" focusable="false"><path d="M2 1v10M2 2h7l-1.5 2L9 6H2" /></svg>High</span>}
                    {card.talk && <span class="hv-talk"><svg viewBox="0 0 12 12" focusable="false"><path d="M1.5 2h9v6h-5L3 10.5V8H1.5z" /></svg>2</span>}
                    <span class="hv-card-avatar"></span>
                  </span>
                </div>
              ))}
              <span class="hv-add">+ Add a card</span>
            </div>
          ))
        }
      </div>
    </div>
    <div class="hv-chat">
      <span class="hv-chat-title"><i></i>{v.chatTitle}</span>
      {
        v.chat.map(msg => (
          <div class:list={['hv-msg', {'hv-msg-mine': msg.mine}]}>
            <span class="hv-msg-who">{msg.who}</span>
            <span class="hv-bubble">{msg.text}</span>
          </div>
        ))
      }
      <span class="hv-compose">Message the board…</span>
    </div>
  </div>
</div>
