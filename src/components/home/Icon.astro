---
/**
 * A small set of 24px stroke icons (Lucide shapes) drawn with `currentColor`,
 * so they take the colour of their tile. Decorative: always `aria-hidden`.
 * Add a shape here when a section needs one; never inline `style=""` (CSP).
 */
export type IconName =
  | 'user'
  | 'dashboard'
  | 'bell'
  | 'shield'
  | 'book'
  | 'briefcase'
  | 'phone'
  | 'arrow-right'
  | 'plus'
  | 'lock'
  | 'rss'
  | 'chat'
  | 'sun'
  | 'command'
  | 'import'
  | 'globe'
  | 'check'
  | 'sparkles'
  | 'mail'
  | 'key'
  | 'arrow-left'
  | 'move'
  | 'tag'
  | 'rows'
  | 'filter'
  | 'copy'
  | 'repeat'
  | 'hash'
  | 'at'
  | 'link'
  | 'inbox'
  | 'table'
  | 'calendar'
  | 'timeline'
  | 'keyboard'
  | 'layers'
  | 'user-plus'
  | 'users'
  | 'history'
  | 'download'
  | 'monitor'
  | 'languages';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const {name, size = 24, class: className} = Astro.props;
