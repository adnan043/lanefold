---
/**
 * The <head> and body for an APP (the portal, or any signed-in app at its own
 * path). NOT the website layout: no site header, no footer, no centered
 * column. The app fills the viewport and draws its own shell (sidebar, top
 * bar) in React, so screens switch without a page load.
 *
 * Signed out / no access: pass the prompt as the slot; it renders
 * centered on the same full-height canvas.
 */
import '@fontsource-variable/inter';
import '../styles/global.css';
import '../styles/app.css';
import '../styles/a11y.css';
import '../styles/forced-colors.css';

import {dirOf, langClass} from '../i18n/locales';
import {parseAcceptLanguage, readLocaleCookie, resolveLocale} from '../i18n/resolve';
import type {Site, Viewer} from '../lib/types';

interface Props {
  site: Site | null;
  viewer: Viewer;
  /** The app's name; the tab shows "<title> · <site>". */
  title: string;
}

const {site, viewer, title} = Astro.props;
const name = site?.name ?? 'My site';
// The language and direction before any script runs (no flash): the `lf_locale` cookie the app sets on a choice, else Accept-Language
// limited to the supported languages, else English. The app re-applies the profile's language in the browser (`applyDocumentLocale`).
const locale = resolveLocale({
  cookie: readLocaleCookie(Astro.request.headers.get('cookie') ?? ''),
  languages: parseAcceptLanguage(Astro.request.headers.get('accept-language')),
});

---

<!doctype html>
<html lang={locale} dir={dirOf(locale)} class={langClass(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{`${title} · ${name}`}</title>
    <!-- Signed-in screens are never search results. -->
    <meta name="robots" content="noindex" />
    {site?.favIcon ? <link rel="icon" href={site.favIcon} /> : <link rel="icon" href="/favicon.svg" type="image/svg+xml" />}
    {/* The admin's brand colour (/dashboard Branding, src/server/routes/branding.ts); empty when none is set. */}
    <link rel="stylesheet" href="/site-api/brand.css" />
    {
      Astro.url.pathname.startsWith('/app') && (
        <>
          <link rel="manifest" href="/manifest.webmanifest" />
          <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
          <meta name="theme-color" content="#0d1110" media="(prefers-color-scheme: dark)" />
          <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
        </>
      )
    }
  </head>
  <body class="app-body" data-viewer={viewer.state}>
    <slot />

    <script>
      import {refreshSession} from '../platform/browser';

      // The theme picked in the dashboard's top bar (src/portal/routes.tsx `useTheme`), before the app draws.
      try {
        const theme = localStorage.getItem('site:theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {
        // Storage blocked: the device's theme.
      }

      // Same as the website layout: the server saw an expired access token but
      // a refresh cookie. Refresh ONCE in the browser, then re-render signed in.
      if (document.body.dataset.viewer === 'returning') {
        const key = 'site:refreshed';
        let first = true;
        try {
          first = !sessionStorage.getItem(key);
          sessionStorage.setItem(key, '1');
        } catch {
          // Storage blocked: no way to remember the reload, so never reload
          // (it would repeat on every load). The visitor signs in again.
          first = false;
        }
        if (first) void refreshSession().then(ok => ok && window.location.reload());
      } else {
        try {
          sessionStorage.removeItem('site:refreshed');
        } catch {
          // Storage blocked: nothing to clear.
        }
      }
    </script>
  </body>
</html>
