---
/**
 * Header, footer and <head> for every page. The page fetches the brand (`site`)
 * and the visitor (`viewer`) with `pageContext` and passes them in, so the
 * layout never makes an API call of its own.
 *
 * Sign-in pages live under `/account/*` on this site (prerendered); the
 * dashboard is `/dashboard`. Plain `<a href>` to both.
 *
 * Navigation between public pages is CLIENT-SIDE (`<ClientRouter />`): real
 * server-rendered pages (best for search), swapped in without a reload and
 * prefetched first (astro.config.mjs). Page scripts run on `astro:page-load`
 * (performance.md "Scripts with the ClientRouter"); the portal has no router, so
 * it is a full load. Only links to PRERENDERED pages carry `data-astro-prefetch` (fetched on hover;
 * the header nav as soon as it is on screen). Pages rendered per visit
 * (`/dashboard`) answer `no-store`: a prefetch of them is thrown away.
 *
 * Structured data (JSON-LD, src/lib/seo.ts): the home page gets `WebSite` +
 * `Organization`; a page passes its own in `jsonLd` (a post).
 */
import '@fontsource-variable/inter';
import '../styles/global.css';
import '../styles/a11y.css';
import '../styles/forced-colors.css';

import {ClientRouter} from 'astro:transitions';

import BrandMark from '../components/BrandMark.astro';
import {FOOTER_NAV, NAV, SITE, USER_MENU, withName} from '../content/site';
import type {Site, Viewer} from '../lib/types';
import {initials} from '../lib/format';
import {absoluteUrl, DEFAULT_SOCIAL_IMAGE, type JsonLd, jsonLdText, siteJsonLd} from '../lib/seo';
import {config} from '../platform/config';

interface Props {
  site: Site | null;
  viewer: Viewer;
  /** The page's own name; the tab shows "<title> · <site>". Omit on home. */
  title?: string;
  /** The meta description (~150 characters). Default: `SITE.description`. */
  description?: string;
  /** A social card image, 1200×630: a `/path` on this site or an https URL. */
  image?: string | null;
  /** Text for the social image (`og:image:alt`). */
  imageAlt?: string;
  /** `article` on a blog post (adds its dates), `website` elsewhere. */
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  /**
   * A PRERENDERED page (`export const prerender = true`): built once, served
   * as a static file, so it knows no visitor. The header then renders the
   * signed-out view and the browser fills in the visitor (`/site-api/me`) and
   * a renamed site (`/site-api/site`) after load.
   */
  isStatic?: boolean;
  /** A list page's JSON route (`/site-api/jobs`): the browser starts fetching it with the page, not after it. */
  preloadData?: string;
  /** Keep the page out of search results (account pages, private pages). */
  noindex?: boolean;
  /** The page URL carries a secret (a reset or confirmation token): send no Referer. */
  secretInUrl?: boolean;
  /** The page's own structured data (src/lib/seo.ts): `postJsonLd(…)`. */
  jsonLd?: JsonLd;
  /**
   * A focused page (sign-in, sign-up, password reset): the header keeps only the brand and a way
   * back to the website, and there is no footer.
   */
  bare?: boolean;
}

const {
  site,
  viewer,
  title,
  description: pageDescription,
  image,
  imageAlt,
  type = 'website',
  publishedAt,
  updatedAt,
  isStatic = false,
  preloadData,
  noindex = false,
  secretInUrl = false,
  jsonLd,
  bare = false,
} = Astro.props;
const name = site?.name ?? 'Lanefold';
// Home has no `title`: it gets the name plus what the product is.
const fullTitle = title ? `${title} · ${name}` : `${name} · Kanban boards with built-in chat`;
const shareTitle = title ?? fullTitle;
const description = pageDescription ?? withName(SITE.description, name);
const path = Astro.url.pathname;
/** Every page URL ends with `/`: prerendered pages are served there (`/about` redirects to `/about/`). */
const withSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
// One URL per page for search engines: the path without its query (filters, paging).
const canonical = noindex || secretInUrl ? null : absoluteUrl(withSlash(path));
const socialImage = absoluteUrl(image ?? DEFAULT_SOCIAL_IMAGE);
const active = (href: string) => (href === '/' ? path === '/' : withSlash(path).startsWith(withSlash(href)));
// Back to this page after signing in. A PATH only (`safeNext` refuses anything else).
// A page whose URL is a secret (a public share link) never copies it into the sign-in link (history, logs).
const back = encodeURIComponent(path.startsWith('/account') || secretInUrl ? '/app' : `${path}${isStatic ? '' : Astro.url.search}`);
// The editor Preview's gateway drops cookies: the server never sees the session
// there, so every page fills the visitor in in the browser, like a prerendered one.
const hydrate = isStatic || (config.preview && viewer.state !== 'user');
// The home page tells search engines the site's name; other pages bring their own.
const indexable = !noindex && !secretInUrl;
const structured = indexable
  ? [...(path === '/' ? [siteJsonLd({name, logo: site?.logo}, description, SITE.lang)] : []), ...(jsonLd ? [jsonLd] : [])]
  : [];
---

<!doctype html>
{/* The public website is always light (owner's choice): `data-theme="light"` turns off the dark
    tokens in global.css and the brand colours. The app and dashboard (App.astro) keep their theme setting. */}
<html lang={SITE.lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {preloadData && <link rel="preload" href={preloadData} as="fetch" crossorigin="anonymous" />}
    {noindex && <meta name="robots" content="noindex" />}
    {secretInUrl && <meta name="referrer" content="no-referrer" />}
    <meta property="og:site_name" content={name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content={imageAlt ?? `${name}: kanban boards with built-in chat`} />}
    {type === 'article' && publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {type === 'article' && updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <meta property="og:locale" content={SITE.lang} />
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && <meta name="twitter:image:alt" content={imageAlt ?? `${name}: kanban boards with built-in chat`} />}
    <meta name="color-scheme" content="light" />
    {site?.favIcon ? <link rel="icon" href={site.favIcon} /> : <link rel="icon" href="/favicon.svg" type="image/svg+xml" />}
    {/* The admin's brand colour (/dashboard Branding, src/server/routes/branding.ts); empty when none is set. */}
    <link rel="stylesheet" href="/site-api/brand.css" />
    <link rel="alternate" type="application/rss+xml" title={`${name} blog`} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {structured.map(data => <script type="application/ld+json" set:html={jsonLdText(data)} />)}
    {/* Client navigation: a click swaps the next page in without a reload (prefetched on hover). The
        portal has no router, so a link to it is a normal page load. Page scripts run on `astro:page-load`. */}
    <ClientRouter />
  </head>
  <body data-viewer={viewer.state} data-static={hydrate ? '1' : undefined} class:list={{'is-bare': bare}}>
    <a class="skip-link" href="#main">Skip to content</a>
    {bare ? (
    <header class="site-header site-header-bare">
      <div class="wrap site-header-inner">
        <a href="/" class="brand" data-astro-prefetch>
          <BrandMark site={site} />
          <span class="brand-name" data-brand-text="{name}" data-built-name={name}>{name}</span>
        </a>
        <a class="bare-back" href="/" data-astro-prefetch>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
          Back to website
        </a>
      </div>
    </header>
    ) : (
    <header class="site-header">
      <div class="wrap site-header-inner">
        <a href="/" class="brand" data-astro-prefetch>
          <BrandMark site={site} />
          <span class="brand-name" data-brand-text="{name}" data-built-name={name}>{name}</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          {NAV.map(item => (
            <a
              href={item.href}
              class:list={{active: active(item.href)}}
              aria-current={active(item.href) ? 'page' : undefined}
              data-astro-prefetch={item.prefetch === false ? undefined : 'viewport'}>
              {item.label}
            </a>
          ))}
        </nav>
        {/* No `data-session` here on purpose: the visitor menu is this site's own (the script below
            fills it in on prerendered pages); `[data-user-only]` / `[data-guest-only]` still toggle. */}
        <div class="session">
          <a class="button link small-button" href={`/account/login/?next=${back}`} data-guest-only hidden={viewer.state === 'user'} data-astro-prefetch>
            Sign in
          </a>
          <a class="button small-button header-cta" href={`/account/register/?next=${back}`} data-guest-only hidden={viewer.state === 'user'} data-astro-prefetch>
            Create account
          </a>
          <div class="user-menu" data-user-menu data-user-only hidden={viewer.state !== 'user'}>
            <button class="user-menu-button" type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="user-menu-list" aria-label={USER_MENU.label}>
              <span class="user-avatar" aria-hidden="true" data-user-initials>{initials(viewer.name ?? '')}</span>
              <svg class="user-menu-caret" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6" /></svg>
            </button>
            <div class="user-menu-panel" id="user-menu-list" role="menu" aria-label={USER_MENU.label} hidden>
              <div class="user-menu-head" role="presentation">
                <span class="user-avatar user-avatar-lg" aria-hidden="true" data-user-initials>{initials(viewer.name ?? '')}</span>
                <span class="user-menu-who">
                  <strong data-user-name>{viewer.name ?? ''}</strong>
                  <span data-user-email>{viewer.state === 'user' ? (viewer.email ?? '') : ''}</span>
                </span>
              </div>
              {USER_MENU.items.map(item => (
                <a class="user-menu-item" role="menuitem" href={item.href} tabindex="-1">
                  {item.icon === 'dashboard' ? (
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><rect width="7" height="9" x="3" y="3" rx="1" /><rect width="7" height="5" x="14" y="3" rx="1" /><rect width="7" height="9" x="14" y="12" rx="1" /><rect width="7" height="5" x="3" y="16" rx="1" /></svg>
                  ) : (
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><rect width="18" height="18" x="3" y="3" rx="2" /><path d="M8 7v7M12 7v4M16 7v9" /></svg>
                  )}
                  {item.label}
                </a>
              ))}
              <div class="user-menu-sep" role="separator"></div>
              <button class="user-menu-item user-menu-out" role="menuitem" type="button" tabindex="-1" data-logout>
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" /></svg>
                {USER_MENU.signOut}
              </button>
            </div>
          </div>
        </div>
      </div>
    </header>
    )}

    <slot />

    {!bare && (
    <footer class="site-footer">
      <div class="wrap site-footer-inner">
        <div class="footer-brand">
          <a href="/" class="brand" data-astro-prefetch>
            <BrandMark site={site} />
            <span class="footer-brand-name" data-brand-text="{name}">{name}</span>
          </a>
          <p data-brand-text={SITE.description}>{withName(SITE.description, name)}</p>
        </div>
        <nav class="footer-col" aria-label="Footer">
          <p class="footer-title">Explore</p>
          <ul>
            {FOOTER_NAV.map(item => (
              <li>
                <a href={item.href} data-astro-prefetch={item.prefetch === false ? undefined : ''}>
                  {item.label}
                </a>
              </li>
            ))}
            <li>
              <a href="/rss.xml">RSS</a>
            </li>
          </ul>
        </nav>
        <nav class="footer-col" aria-label="Account">
          <p class="footer-title">Account</p>
          <ul>
            <li data-guest-only hidden={viewer.state === 'user'}>
              <a href={`/account/login/?next=${back}`} data-astro-prefetch>Sign in</a>
            </li>
            <li data-guest-only hidden={viewer.state === 'user'}>
              <a href={`/account/register/?next=${back}`} data-astro-prefetch>Create account</a>
            </li>
            <li data-user-only hidden={viewer.state !== 'user'}>
              <a href="/dashboard">Dashboard</a>
            </li>
            <li>
              <a href="/account/forgot/" data-astro-prefetch>Forgot your password?</a>
            </li>
          </ul>
        </nav>
      </div>
      <div class="site-footer-bottom">
        <div class="wrap">
          <span data-brand-text="© {year} {name}">© {new Date().getUTCFullYear()} {name}</span>
        </div>
      </div>
    </footer>
    )}

    <script>
      import {logout, refreshSession, siteFetch} from '../platform/browser';
      import {hydrateStaticPage} from '../platform/static-page';
      import {notifyPaymentOpener} from '../lib/checkout-session';
      // Every button shows when it is busy (AGENTS.md "Buttons and forms").
      const busy = (button: HTMLButtonElement, label?: string) => {
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        if (label) button.textContent = label;
      };

      // Each page, the first load and every client navigation (ClientRouter): the body is new.
      document.addEventListener('astro:page-load', () => {
        // Back from the payment provider INSIDE the payment window: tell the checkout page, close.
        notifyPaymentOpener();
        if (document.body.dataset.static === '1') void hydrateStaticPage().then(fillUserMenu);
        bindUserMenu();

        // The server saw an expired access token but a refresh cookie: refresh
        // ONCE in the browser (the server never rotates it), then re-render signed in.
        if (document.body.dataset.viewer === 'returning') {
          const key = 'site:refreshed';
          let first = true;
          try {
            first = !sessionStorage.getItem(key);
            sessionStorage.setItem(key, '1');
          } catch {
            // Storage blocked: no way to remember the reload, so never reload
            // (it would repeat on every load). The visitor signs in again.
            first = false;
          }
          if (first) void refreshSession().then(ok => ok && window.location.reload());
        } else {
          try {
            sessionStorage.removeItem('site:refreshed');
          } catch {
            // Storage blocked: nothing to clear.
          }
        }

        document.querySelectorAll<HTMLButtonElement>('[data-logout]').forEach(button =>
          button.addEventListener('click', () => {
            busy(button, 'Signing out…');
            void logout();
          })
        );
      });

      /** Initials for the round avatar. */
      const initialsOf = (name: string) =>
        name
          .split(/\s+/)
          .filter(Boolean)
          .slice(0, 2)
          .map(word => word[0]?.toUpperCase() ?? '')
          .join('') || '·';

      /**
       * A prerendered page knows no visitor: once the platform has marked a signed-in visitor
       * (`data-viewer="user"`), put their name in the avatar menu. Their OWN name and email only,
       * written with `textContent`.
       */
      async function fillUserMenu() {
        if (document.body.dataset.viewer !== 'user') return;
        const menu = document.querySelector<HTMLElement>('[data-user-menu]');
        if (!menu) return;
        try {
          const res = await siteFetch('/site-api/me', {headers: {accept: 'application/json'}});
          const body = (await res.json()) as {viewer?: {name?: string | null; email?: string | null}};
          const name = body.viewer?.name ?? '';
          menu.querySelectorAll<HTMLElement>('[data-user-initials]').forEach(el => (el.textContent = initialsOf(name)));
          menu.querySelectorAll<HTMLElement>('[data-user-name]').forEach(el => (el.textContent = name));
          menu.querySelectorAll<HTMLElement>('[data-user-email]').forEach(el => (el.textContent = body.viewer?.email ?? ''));
        } catch {
          // The menu still works with the initials it has.
        }
      }

      /** The avatar button opens a small menu: Dashboard, Your boards, Sign out (WAI-ARIA menu button). */
      function bindUserMenu() {
        const menu = document.querySelector<HTMLElement>('[data-user-menu]');
        if (!menu) return;
        const button = menu.querySelector<HTMLButtonElement>('.user-menu-button')!;
        const panel = menu.querySelector<HTMLElement>('.user-menu-panel')!;
        const items = () => [...panel.querySelectorAll<HTMLElement>('[role="menuitem"]')];
        const isOpen = () => !panel.hidden;
        const open = (focus: 'first' | 'last' | null = null) => {
          panel.hidden = false;
          button.setAttribute('aria-expanded', 'true');
          const list = items();
          if (focus) (focus === 'first' ? list[0] : list[list.length - 1])?.focus();
        };
        const close = (returnFocus = false) => {
          if (!isOpen()) return;
          panel.hidden = true;
          button.setAttribute('aria-expanded', 'false');
          if (returnFocus) button.focus();
        };
        button.addEventListener('click', () => (isOpen() ? close() : open('first')));
        button.addEventListener('keydown', event => {
          if (event.key === 'ArrowDown') {
            event.preventDefault();
            open('first');
          } else if (event.key === 'ArrowUp') {
            event.preventDefault();
            open('last');
          }
        });
        panel.addEventListener('keydown', event => {
          const list = items();
          const at = list.indexOf(document.activeElement as HTMLElement);
          let to = -1;
          if (event.key === 'ArrowDown') to = (at + 1) % list.length;
          else if (event.key === 'ArrowUp') to = (at - 1 + list.length) % list.length;
          else if (event.key === 'Home') to = 0;
          else if (event.key === 'End') to = list.length - 1;
          else if (event.key === 'Escape') {
            event.preventDefault();
            close(true);
            return;
          } else if (event.key === 'Tab') {
            close();
            return;
          }
          if (to < 0) return;
          event.preventDefault();
          list[to]?.focus();
        });
      }

      // Once for the document (it stays across navigations):

      // A click outside the avatar menu closes it (whichever page is showing).
      document.addEventListener('click', event => {
        const menu = document.querySelector<HTMLElement>('[data-user-menu]');
        const panel = menu?.querySelector<HTMLElement>('.user-menu-panel');
        if (!menu || !panel || panel.hidden || menu.contains(event.target as Node)) return;
        panel.hidden = true;
        menu.querySelector('.user-menu-button')?.setAttribute('aria-expanded', 'false');
      });

      // A search / filter form (GET) navigates: show its button busy until the next page.
      document.addEventListener('submit', event => {
        const form = event.target;
        if (event.defaultPrevented || !(form instanceof HTMLFormElement)) return;
        if (form.method.toLowerCase() !== 'get') return;
        if (event.submitter instanceof HTMLButtonElement) busy(event.submitter);
      });
      // Back/forward restores a page from memory (a full load's bfcache): give its buttons back.
      window.addEventListener('pageshow', event => {
        if (!event.persisted) return;
        document.querySelectorAll<HTMLButtonElement>('button[aria-busy="true"]').forEach(button => {
          button.disabled = false;
          button.removeAttribute('aria-busy');
        });
      });
    </script>
  </body>
</html>
