---
/**
 * Sign in. PRERENDERED (a file, no server work). One screen with two tabs, Sign in and Create
 * account (`src/components/auth/AuthTabs.astro`); this address opens on Sign in. How sign-in works
 * (emailed code, password, two-step, `?mfa=`, `?notice=`, `?next=`): `src/lib/auth-signin.ts`.
 */
import AuthShell from '../../components/auth/AuthShell.astro';
import AuthTabs from '../../components/auth/AuthTabs.astro';
import Base from '../../layouts/Base.astro';
import '../../styles/account.css';
import {staticContext} from '../../server/page';

export const prerender = true;

const {site, viewer} = await staticContext(Astro.request);
---

<Base site={site} viewer={viewer} isStatic noindex bare title="Sign in">
  <AuthShell>
    <AuthTabs active="signin" />
  </AuthShell>
</Base>
