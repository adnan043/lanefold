---
/**
 * Create an account. PRERENDERED. The same two-tab screen as `/account/login/`
 * (`src/components/auth/AuthTabs.astro`), opened on Create account. How sign-up works:
 * `src/lib/auth-signup.ts` (posts to `/site-api/auth/register`; with email confirmation on, the
 * answer is the same whether or not the email already has an account).
 */
import AuthShell from '../../components/auth/AuthShell.astro';
import AuthTabs from '../../components/auth/AuthTabs.astro';
import Base from '../../layouts/Base.astro';
import '../../styles/account.css';
import {staticContext} from '../../server/page';

export const prerender = true;

const {site, viewer} = await staticContext(Astro.request);
---

<Base site={site} viewer={viewer} isStatic noindex bare title="Create an account">
  <AuthShell>
    <AuthTabs active="signup" />
  </AuthShell>
</Base>
